# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# ID чата барбера для уведомлений о новых записях
# Как получить: отправьте /start боту, в консоли будет выведен chat_id
BARBER_CHAT_ID=123456789

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=barber_bot

# Timezone (примеры: Europe/Moscow, Europe/London, US/Eastern)
TIMEZONE=Europe/Moscow

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
