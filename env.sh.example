#!/bin/bash
# Telegram Bot
export TELEGRAM_BOT_TOKEN=""  # Получите в @BotFather
export TELEGRAM_BOT_USERNAME=""  # Имя вашего бота без @

# ID чата барбера для уведомлений о новых записях
# Как получить: отправьте /start боту, в консоли будет выведен chat_id
export BARBER_CHAT_ID=""

# MongoDB
export MONGODB_URI="mongodb://admin:password@localhost:27017"
export DATABASE_NAME="barber_bot"

# Timezone (примеры: Europe/Moscow, Europe/London, US/Eastern)
export TIMEZONE="Europe/Moscow"

# Logging (DEBUG, INFO, WARNING, ERROR)
export LOG_LEVEL="INFO"
